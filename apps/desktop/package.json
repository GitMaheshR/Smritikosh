{
  "name": "@smritikosh/desktop",
  "version": "0.1.0",
  "private": true,
  "productName": "Smritikosh",
  "description": "Smritikosh - personal memory keeper",
  "author": "Smritikosh",
  "main": "dist/main.cjs",
  "scripts": {
    "build:main": "esbuild src/main.ts src/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist --out-extension:.js=.cjs",
    "dev": "pnpm --filter @smritikosh/ui build && pnpm build:main && electron .",
    "dist": "pnpm --filter @smritikosh/ui build && pnpm build:main && electron-builder --win nsis",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@smritikosh/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "app.smritikosh.desktop",
    "productName": "Smritikosh",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../ui/dist",
        "to": "ui"
      }
    ],
    "npmRebuild": false,
    "win": {
      "signAndEditExecutable": false,
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}