{
  "name": "@smritikosh/mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync": "pnpm --filter @smritikosh/ui build && cap sync android",
    "sync:ios": "pnpm --filter @smritikosh/ui build && cap sync ios",
    "apk": "pnpm sync && cd android && gradlew.bat assembleDebug",
    "typecheck": "echo ok"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^6.0.2",
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/app-launcher": "^6.0.4",
    "@capacitor/core": "^6.1.2",
    "@capacitor/device": "^6.0.3",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/geolocation": "^6.1.1",
    "@capacitor/ios": "^6.2.3",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/preferences": "^6.0.2",
    "@capacitor/share": "^6.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2"
  }
}
