{
  "name": "smritikosh",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "dev:ui": "pnpm --filter @smritikosh/ui dev",
    "build:ui": "pnpm --filter @smritikosh/ui build",
    "dev:desktop": "pnpm --filter @smritikosh/desktop dev",
    "dist:desktop": "pnpm --filter @smritikosh/desktop dist",
    "sync:mobile": "pnpm --filter @smritikosh/mobile sync",
    "apk:debug": "pnpm --filter @smritikosh/mobile apk",
    "license:keygen": "node scripts/license-keygen.mjs",
    "license:tool": "node scripts/build-license-tool.mjs",
    "icons": "apps/desktop/node_modules/.bin/electron scripts/make-icons.cjs",
    "apk:create-key": "powershell -NoProfile -STA -ExecutionPolicy Bypass -File scripts/create-release-key.ps1",
    "apk:release": "powershell -NoProfile -STA -ExecutionPolicy Bypass -File scripts/build-release.ps1"
  }
}